# Application Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# Frontend Environment (Vite)
VITE_API_URL=http://localhost:5000

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brightloop_subs?schema=public

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_brightloop_dev_only
JWT_EXPIRES_IN=7d
RESET_TOKEN_TTL_MINUTES=15

# SMTP / Email Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=smtp_username_placeholder
SMTP_PASS=smtp_password_placeholder
MAIL_FROM="Brightloop Software <no-reply@brightloop.com>"

# Billing & Scheduled Jobs
BILLING_CRON="0 0 * * *"
