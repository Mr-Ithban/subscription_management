// Prisma schema for Brightloop Software Subscription Management System
// Datasource and generator configuration only (business models owned by feature teams)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== PAYMENTS =====
enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  UPI
  CHEQUE
  ONLINE
}

model Payment {
  id          String        @id @default(cuid())
  invoiceId   String
  method      PaymentMethod
  amount      Int
  paidAt      DateTime
  note        String?
  createdById String?
  createdAt   DateTime      @default(now())

  @@index([invoiceId])
  @@index([paidAt])
}
