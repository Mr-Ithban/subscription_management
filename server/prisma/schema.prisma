// Prisma schema for Brightloop Software Subscription Management System
// Datasource and generator configuration only (business models owned by feature teams)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== AUTH =====
enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  role           Role      @default(CUSTOMER)
  resetTokenHash String?
  resetExpiry    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  customer       Customer?
}

model Customer {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  name      String
  phone     String?
  address   String?
  createdAt DateTime @default(now())
}

// ===== CATALOG =====

enum ProductType {
  SERVICE
  GOODS
  SOFTWARE
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum PlanStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum DiscountType {
  FIXED
  PERCENT
}

enum DiscountAppliesTo {
  PRODUCT
  SUBSCRIPTION
}

model Tax {
  id        String   @id @default(uuid())
  name      String
  rate      Decimal  @db.Decimal(5, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id         String           @id @default(uuid())
  name       String
  type       ProductType
  salesPrice Int
  costPrice  Int
  notes      String?
  active     Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  variants   ProductVariant[]
  discounts  Discount[]
}

model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute  String
  value      String
  extraPrice Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([productId, attribute, value])
}

model Plan {
  id              String        @id @default(uuid())
  name            String
  price           Int
  billingPeriod   BillingPeriod
  minQty          Int           @default(1)
  startDate       DateTime
  endDate         DateTime?
  status          PlanStatus    @default(ACTIVE)
  autoClose       Boolean       @default(false)
  allowPause      Boolean       @default(true)
  allowEarlyClose Boolean       @default(true)
  allowRenew      Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status])
}

model Discount {
  id          String            @id @default(uuid())
  name        String
  type        DiscountType
  value       Int
  minPurchase Int?
  minQty      Int?
  startDate   DateTime
  endDate     DateTime
  usageLimit  Int?
  usedCount   Int               @default(0)
  appliesTo   DiscountAppliesTo
  productId   String?
  product     Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([endDate])
}
