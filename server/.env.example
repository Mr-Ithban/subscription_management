# Pooled Neon connection URL for application traffic (hostname contains -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/brightloop_subs?sslmode=require"

# Direct Neon connection URL for Prisma CLI and migrations (hostname has no -pooler).
DIRECT_URL="postgresql://USER:PASSWORD@HOST/brightloop_subs?sslmode=require"

PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
RESET_TOKEN_TTL_MINUTES=15

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional seedLarge.js settings
SEED_CUSTOMERS=5000
SEED_SUBSCRIPTIONS=8000
SEED_INVOICES=20000
SEED_PAYMENTS=15000
